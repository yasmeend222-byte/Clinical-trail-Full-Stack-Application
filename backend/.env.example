# Database: SQLite by default. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/contextsync
DATABASE_URL=

# Secret used to sign auth tokens - change in production
SECRET_KEY=change-me-in-production
TOKEN_TTL_HOURS=12

# Optional LLM for explanations (any OpenAI-compatible API).
# Llama via Ollama:   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1   LLM_API_KEY=ollama
# OpenAI GPT:         LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini LLM_API_KEY=sk-...
# Leave LLM_BASE_URL empty to use the built-in template explainer.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3.1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
